# =============================================================================
# iHIM Flight Path - Workflow Visualizer
# Multi-stage Docker build for dependency graph visualization
# =============================================================================

# Stage 1: Build dependencies
FROM python:3.12-slim as builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Create requirements file for Flight Path
COPY requirements.txt .
RUN echo "\n# Flight Path dependencies\nnetworkx==3.4.2\npydot==3.0.1\npygraphviz==1.13" >> requirements-flightpath.txt && \
    cat requirements.txt >> requirements-flightpath.txt

# Create virtual environment and install dependencies
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-flightpath.txt || \
    pip install --no-cache-dir fastapi uvicorn networkx pydot


# Stage 2: Production image
FROM python:3.12-slim as production

# Labels
LABEL org.opencontainers.image.title="iHIM Flight Path"
LABEL org.opencontainers.image.description="Workflow Visualizer for EdgeFlow AI"
LABEL org.opencontainers.image.version="1.0.0"

# Install graphviz for visualization
RUN apt-get update && apt-get install -y --no-install-recommends \
    graphviz \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN groupadd --gid 1000 flightpath && \
    useradd --uid 1000 --gid flightpath --shell /bin/bash --create-home flightpath

WORKDIR /app

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy Flight Path application code
# Note: This expects a flightpath/ directory with the visualization service
COPY --chown=flightpath:flightpath api/ ./api/

# Create cache directory with proper permissions
RUN mkdir -p /app/cache && chown -R flightpath:flightpath /app/cache

# Environment configuration (overridable)
ENV FLIGHTPATH_HOST=${FLIGHTPATH_HOST:-0.0.0.0}
ENV FLIGHTPATH_PORT=${FLIGHTPATH_PORT:-7780}
ENV FLIGHTPATH_LOG_LEVEL=${FLIGHTPATH_LOG_LEVEL:-info}
ENV FLIGHTPATH_SCAN_DEPTH=${FLIGHTPATH_SCAN_DEPTH:-3}
ENV FLIGHTPATH_REFRESH_INTERVAL=${FLIGHTPATH_REFRESH_INTERVAL:-30}
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Switch to non-root user
USER flightpath

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:${FLIGHTPATH_PORT}/api/health')" || exit 1

# Expose port
EXPOSE 7780

# Start command
CMD ["sh", "-c", "uvicorn api.flightpath:app --host ${FLIGHTPATH_HOST} --port ${FLIGHTPATH_PORT} --log-level ${FLIGHTPATH_LOG_LEVEL}"]
