{
  "id": "red-team-recon",
  "name": "Red Team: Recon Wave",
  "version": "1.0.0",
  "created_at": "2025-12-27",
  "updated_at": "2025-12-27",

  "what": "10 the agent scouts perform adversarial analysis of the codebase. READ-ONLY. Finds security vulnerabilities, bugs, edge cases, and design flaws. Wave 1 of the Red Team pattern - all findings go directly to the agent for synthesis (no the agent intermediary needed).",

  "when_to_use": [
    "Before marking a feature 'done'",
    "After completing a significant refactor",
    "Starting a session focused on iHIM development",
    "When the operator asks about bugs, security, or code quality",
    "Periodic health checks on critical systems"
  ],

  "when_not_to_use": [
    "Mid-implementation (wait for stable state)",
    "On untested prototype code (too noisy)",
    "When time doesn't allow for fix wave after"
  ],

  "philosophy": "Adversarial testing mindset. Break it to find the patches. Every scout hunts independently - overlap is acceptable because different perspectives catch different bugs. Quantity of eyes beats precision of search.",

  "composition": {
    "total_agents": 10,
    "parallelism_slots": 10,
    "wave": 1,
    "next_wave": "red-team-fix",
    "breakdown": [
      {
        "id": "scout-api",
        "tier": "haiku",
        "role": "scout",
        "access": "read-only",
        "specialty": "API Security",
        "file_patterns": ["IHIM/api/**/*.py"],
        "audit_patterns": ["input_validation", "cors_config", "auth_bypass", "rate_limiting"]
      },
      {
        "id": "scout-actions",
        "tier": "haiku",
        "role": "scout",
        "access": "read-only",
        "specialty": "Command Injection",
        "file_patterns": ["IHIM/actions/**/*.py"],
        "audit_patterns": ["subprocess_calls", "shell_escaping", "command_injection"]
      },
      {
        "id": "scout-team",
        "tier": "haiku",
        "role": "scout",
        "access": "read-only",
        "specialty": "Concurrency",
        "file_patterns": ["IHIM/team/**/*.py"],
        "audit_patterns": ["race_conditions", "file_locking", "shared_state", "deadlocks"]
      },
      {
        "id": "scout-data",
        "tier": "haiku",
        "role": "scout",
        "access": "read-only",
        "specialty": "Data Integrity",
        "file_patterns": ["IHIM/data/**/*.json", "IHIM/team/**/*.py"],
        "audit_patterns": ["json_parsing", "atomic_writes", "data_corruption", "silent_failures"]
      },
      {
        "id": "scout-ui-js",
        "tier": "haiku",
        "role": "scout",
        "access": "read-only",
        "specialty": "JavaScript Security",
        "file_patterns": ["IHIM/ui/**/*.html"],
        "audit_patterns": ["xss_vulnerabilities", "dom_injection", "eval_usage", "event_leaks"]
      },
      {
        "id": "scout-ui-html",
        "tier": "haiku",
        "role": "scout",
        "access": "read-only",
        "specialty": "HTML/Form Security",
        "file_patterns": ["IHIM/ui/**/*.html"],
        "audit_patterns": ["csrf_protection", "form_security", "clickjacking"]
      },
      {
        "id": "scout-css",
        "tier": "haiku",
        "role": "scout",
        "access": "read-only",
        "specialty": "CSS/Layout Bugs",
        "file_patterns": ["IHIM/ui/**/*.css"],
        "audit_patterns": ["overflow_issues", "z_index_conflicts", "responsive_bugs", "accessibility"]
      },
      {
        "id": "scout-tests",
        "tier": "haiku",
        "role": "scout",
        "access": "read-only",
        "specialty": "Test Coverage Gaps",
        "file_patterns": ["IHIM/tests/**/*.py"],
        "audit_patterns": ["coverage_gaps", "missing_edge_cases", "security_test_gaps"]
      },
      {
        "id": "scout-errors",
        "tier": "haiku",
        "role": "scout",
        "access": "read-only",
        "specialty": "Error Handling",
        "file_patterns": ["IHIM/**/*.py"],
        "audit_patterns": ["bare_except", "error_disclosure", "stack_traces", "silent_failures"]
      },
      {
        "id": "scout-design",
        "tier": "haiku",
        "role": "scout",
        "access": "read-only",
        "specialty": "Design Flaws",
        "file_patterns": ["IHIM/**/*"],
        "audit_patterns": ["architecture_issues", "missing_validation", "boundary_cases", "resource_limits"]
      }
    ]
  },

  "constraints": [
    "ALL scouts are READ-ONLY (structural enforcement)",
    "Use severity tags: [CRITICAL/HIGH/MEDIUM/LOW]",
    "Report format: [SEVERITY] file:line - Finding",
    "No the agent intermediary - the agent aggregates directly",
    "Each scout works independently (no coordination needed)"
  ],

  "output": {
    "format": "JSON with file:line, severity, finding, recommendation",
    "aggregation": "the agent synthesizes all 10 reports into prioritized list",
    "escalation": "Any CRITICAL finding triggers immediate attention"
  },

  "examples": [
    {
      "scenario": "Feature implementation complete",
      "result": "Found 17 bugs: 4 CRITICAL, 7 HIGH, 6 MEDIUM"
    },
    {
      "scenario": "Quick Notes drag implementation",
      "result": "Found missing preventDefault, mouseleave handler, event leak"
    }
  ],

  "metrics": {
    "target_completion_time": "< 5 minutes (parallel)",
    "expected_finding_rate": "10-40 issues typical",
    "token_budget": "30,000 - 50,000 tokens",
    "success_criteria": "All 10 scouts complete, findings prioritized"
  },

  "history": {
    "runs": 0,
    "avg_duration_seconds": null,
    "avg_findings": null,
    "lessons_extracted": []
  }
}
